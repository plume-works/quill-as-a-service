# Quill's secrets and settings. Copy to etc/service.env next to compose.yml, mode 600.
# systemd reads this file: one NAME=value per line, no `export`.

# The webhook secret set in the Quill App's settings.
QUILL_WEBHOOK_SECRET=
# The Quill App's client ID (App settings, General).
QUILL_APP_CLIENT_ID=
# The App's private key on one line, its newlines written as \n, in double quotes:
#   awk 'BEGIN{ORS="\\n"}1' quill.private-key.pem
QUILL_APP_PRIVATE_KEY=""
# The Claude Code OAuth token that reviews run on (`claude setup-token`).
CLAUDE_CODE_OAUTH_TOKEN=
# The reviewer image, by tag and digest.
QUILL_REVIEWER_IMAGE=ghcr.io/plume-works/quill-reviewer:edge@sha256:<digest>
